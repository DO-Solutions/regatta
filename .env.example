# Required: DigitalOcean GenAI model access key (GenAI Platform console → Model access keys).
# Needs access to the models you race (kimi-k2.6, kimi-k3, anthropic-claude-opus-5).
DO_KEY=

# Optional: judge override (default deepseek-v4-pro — open source, third-family)
#JUDGE_MODEL=deepseek-v4-pro

# Optional retrieval — pick ONE (or none for a context-free comparison):
#RAG_CACHE=chunks.json
#RAG_URL=http://127.0.0.1:8001
#RAG_KEY=

# Optional: serve the K3 arm from any OpenAI-compatible endpoint instead of DO
#K3_BASE=
#K3_MODEL_ID=
#K3_KEY=

# Optional: route the Opus arm via the Anthropic API instead of DO
#OPUS_BACKEND=anthropic
#ANTHROPIC_KEY=

# Optional: dataset + port
#DATASET=evalset.csv
#PORT=8130
